@startuml
title Diagrammes des cycles métier - Marketplace

skinparam shadowing false

skinparam state {
    BackgroundColor White
    BorderColor Black
    FontSize 12
}

skinparam ArrowColor Black


' =====================================================
' 1 - CYCLE DE VIE D'UNE COMMANDE
' =====================================================

state "Cycle de vie d'une commande" as CycleCommande {

[*] --> CreeeCommande : Validation du panier

CreeeCommande --> AttentePaiementCommande : Commande créée\nCalcul montant total

AttentePaiementCommande --> PayeeCommande : Paiement validé

PayeeCommande --> PreparationCommande : Notification vendeurs\nPréparation produits

PreparationCommande --> ExpedieeCommande : Produits préparés\nRegroupement logistique

ExpedieeCommande --> LivraisonCommande : Affectation\nUtilisateur rôle Livreur

LivraisonCommande --> LivreeCommande : Réception confirmée\npar acheteur

LivreeCommande --> TermineeCommande : Clôture processus commercial


CreeeCommande --> AnnuleeCommande : Annulation autorisée

AttentePaiementCommande --> AnnuleeCommande : Paiement échoué\nou annulation

PayeeCommande --> AnnuleeCommande : Cas exceptionnel

}


newpage


' =====================================================
' 2 - CYCLE DE VIE D'UNE LIVRAISON
' =====================================================

state "Cycle de vie d'une livraison" as CycleLivraison {

[*] --> LivraisonCreee : Commande prête

LivraisonCreee --> AttenteAffectationLivraison : Création livraison

AttenteAffectationLivraison --> AffecteeLivraison : Affectation utilisateur\n(rôle Livreur)

AffecteeLivraison --> RecuperationLivraison : Livreur récupère la commande

RecuperationLivraison --> LivraisonEnCours : Transport vers acheteur

LivraisonEnCours --> LivreeLivraison : Confirmation réception


LivraisonEnCours --> EchecLivraison : Problème livraison

EchecLivraison --> NouvelleTentativeLivraison : Réorganisation livraison

NouvelleTentativeLivraison --> AffecteeLivraison

EchecLivraison --> AnnuleeLivraison : Décision métier

}


newpage


' =====================================================
' 3 - CYCLE DE VIE D'UN PAIEMENT
' =====================================================

state "Cycle de vie d'un paiement" as CyclePaiement {

[*] --> PaiementCree : Création commande

PaiementCree --> PaiementAttente : Demande paiement

PaiementAttente --> PaiementAccepte : Paiement confirmé

PaiementAttente --> PaiementRefuse : Paiement échoué

PaiementAccepte --> PaiementRembourse : Demande remboursement

PaiementRefuse --> [*]

PaiementRembourse --> [*]

}


newpage


' =====================================================
' 4 - CYCLE DE TRAITEMENT D'UN TICKET SUPPORT
' =====================================================

state "Cycle de traitement d'un ticket support" as CycleSupport {

[*] --> TicketOuvert : Création ticket

TicketOuvert --> TicketPrisEnCharge : Utilisateur rôle Support\nattribué

TicketPrisEnCharge --> TicketEnTraitement : Analyse du problème

TicketEnTraitement --> TicketResolu : Solution apportée

TicketResolu --> TicketFerme : Validation fermeture

}


@enduml